# =============================================================
# PECI PROJECT — Environment Variables
# Copia este ficheiro para .env e preenche com os valores reais.
# O ficheiro .env NUNCA vai para o Git.
# =============================================================

# Base de dados
DB_USER=peci_user
DB_PASSWORD=password_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peci_db

# JWT
SECRET_KEY=ba0395fb557dee1c289c1b18ad05ac0b6f63fb457a24c3d454725085936eca49
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth cookie (httpOnly)
AUTH_COOKIE_NAME=peci_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

# CORS (comma-separated origins)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
